class Solution:
    def maxEnvelopes(self, envelopes):
        # Sort by width increasing.
        # If widths are equal, sort height decreasing.
        envelopes.sort(key=lambda x: (x[0], -x[1]))

        # Find LIS on heights
        lis = []

        for w, h in envelopes:
            left = 0
            right = len(lis)

            # Find first position where lis[pos] >= h
            while left < right:
                mid = (left + right) // 2

                if lis[mid] < h:
                    left = mid + 1
                else:
                    right = mid

            if left == len(lis):
                lis.append(h)
            else:
                lis[left] = h

        return len(lis)
