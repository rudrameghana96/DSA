class Solution:
    def fourSumCount(self, nums1, nums2, nums3, nums4):
        count = {}

        # Store frequencies of sums from nums1 and nums2
        for a in nums1:
            for b in nums2:
                s = a + b
                count[s] = count.get(s, 0) + 1

        ans = 0

        # Find the required opposite sum in nums3 and nums4
        for c in nums3:
            for d in nums4:
                s = -(c + d)
                if s in count:
                    ans += count[s]

        return ans
