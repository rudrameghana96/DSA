class Solution:
    def largestDivisibleSubset(self, nums):
        nums.sort()
        n = len(nums)

        dp = [1] * n
        parent = [-1] * n

        max_len = 1
        last = 0

        for i in range(n):
            for j in range(i):
                if nums[i] % nums[j] == 0:
                    if dp[j] + 1 > dp[i]:
                        dp[i] = dp[j] + 1
                        parent[i] = j

            if dp[i] > max_len:
                max_len = dp[i]
                last = i

        answer = []

        while last != -1:
            answer.append(nums[last])
            last = parent[last]

        return answer[::-1]
