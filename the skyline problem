import heapq

class Solution:
    def getSkyline(self, buildings):
        events = []

        # Create start and end events
        for left, right, height in buildings:
            events.append((left, -height, right))   # Building starts
            events.append((right, 0, 0))            # Building ends

        events.sort()

        res = []
        heap = [(0, float('inf'))]   # (-height, end)

        for x, negH, right in events:
            # Remove buildings that have ended
            while heap and heap[0][1] <= x:
                heapq.heappop(heap)

            # Add new building
            if negH != 0:
                heapq.heappush(heap, (negH, right))

            currHeight = -heap[0][0]

            # Add key point if height changes
            if not res or res[-1][1] != currHeight:
                res.append([x, currHeight])

        return res
